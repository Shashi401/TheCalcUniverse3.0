---
import Base from "../layouts/Base.astro";
---

<Base
  title="TheCalcUniverse — Calculators You Can Verify"
  description="Free calculators with the work shown: verifiably correct answers, scenario comparison, and your numbers never leave your device."
>
  <div style="max-width:65ch;margin:64px auto;text-align:center">
    <h1 style="font-size:42px">Ask a number-shaped question.</h1>
    <p class="promise" style="margin:12px auto 28px">
      Get a verifiably correct answer in seconds — with the work shown, your options compared,
      nothing in your way, and your numbers never leaving your device.
    </p>
    <a
      href="/finance/mortgage-calculator/"
      style="display:inline-block;background:var(--accent);color:var(--accent-ink);border-radius:10px;padding:12px 22px;font:600 15px var(--font-ui)"
    >Try the Mortgage Calculator →</a>
  </div>
</Base>
